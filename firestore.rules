rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function user() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function isAdmin() { return signedIn() && user().role == 'admin'; }
    function isDoctor() { return signedIn() && user().role == 'doctor'; }
    function isPatient() { return signedIn() && user().role == 'patient'; }
    function unchanged(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasNone(fields); }
    function conversationParticipant(conversationId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /users/{userId} {
      allow create: if signedIn() && uid() == userId
        && request.resource.data.uid == uid()
        && request.resource.data.role in ['patient', 'doctor'];
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow update: if signedIn() && (
        isAdmin() || (uid() == userId && unchanged(['uid', 'role', 'isVerified', 'isActive']))
      );
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if signedIn();
      allow create: if isDoctor() && uid() == doctorId
        && request.resource.data.userId == uid()
        && request.resource.data.documentsVerified == false;
      allow update: if isAdmin() || (isDoctor() && uid() == doctorId
        && unchanged(['userId', 'documentsVerified']));
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn() && (resource.data.patientId == uid() || resource.data.doctorId == uid() || isAdmin());
      allow create: if (
        (isPatient() && request.resource.data.patientId == uid() && request.resource.data.status == 'pending') ||
        (isDoctor() && request.resource.data.doctorId == uid() && request.resource.data.status == 'confirmed')
      ) && request.resource.data.doctorId is string
        && request.resource.data.doctorId.size() > 0
        && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId));
      allow update: if signedIn() && (
        (resource.data.patientId == uid()
          && request.resource.data.status == 'cancelled'
          && unchanged(['patientId', 'doctorId', 'patientName', 'doctorName', 'date', 'time', 'type', 'motif'])) ||
        (resource.data.doctorId == uid()
          && request.resource.data.status in ['pending', 'confirmed', 'cancelled', 'completed', 'no_show']
          && unchanged(['patientId', 'doctorId', 'patientName', 'doctorName'])) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
      allow create: if signedIn() && uid() in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1];
      allow update: if conversationParticipant(conversationId)
        && unchanged(['participantIds', 'participantNames']);
    }

    match /messages/{messageId} {
      allow read: if conversationParticipant(resource.data.conversationId);
      allow create: if signedIn() && request.resource.data.senderId == uid()
        && conversationParticipant(request.resource.data.conversationId);
    }

    match /prescriptions/{prescriptionId} {
      allow read: if signedIn() && (resource.data.patientId == uid() || resource.data.doctorId == uid() || isAdmin());
      allow create: if isDoctor() && request.resource.data.doctorId == uid()
        && request.resource.data.patientId is string && request.resource.data.patientId.size() > 0;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /medication_reminders/{reminderId} {
      allow read: if signedIn() && resource.data.patientId == uid();
      allow create: if isPatient() && request.resource.data.patientId == uid();
      allow update, delete: if signedIn() && resource.data.patientId == uid()
        && unchanged(['patientId']);
    }

    match /medical_profiles/{patientId} {
      allow read: if signedIn() && (uid() == patientId || isAdmin());
      allow create: if isPatient() && uid() == patientId
        && request.resource.data.patientId == uid();
      allow update: if isPatient() && uid() == patientId
        && unchanged(['patientId']);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == uid();
      allow create, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if isPatient() && request.resource.data.patientId == uid();
      allow update, delete: if signedIn() && resource.data.patientId == uid();
    }

    match /specialties/{specialtyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /consultations/{consultationId} {
      allow read: if signedIn() && (resource.data.patientId == uid() || resource.data.doctorId == uid() || isAdmin());
      allow create: if isDoctor() && request.resource.data.doctorId == uid();
      allow update: if isDoctor() && resource.data.doctorId == uid();
    }

    match /constantes_vitales/{vitalsId} {
      allow read: if signedIn() && (resource.data.patientId == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.patientId == uid()
        && request.resource.data.source in ['manual', 'certified_device'];
      allow update, delete: if false;
    }
  }
}
