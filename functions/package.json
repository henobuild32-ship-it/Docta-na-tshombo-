{
  "name": "docta-functions",
  "private": true,
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "test": "npm run build",
    "test:rules": "firebase emulators:exec --only firestore \"jest test/firestore.rules.test.js --runInBand\""
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "jest": "^29.7.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.5",
    "typescript": "^5.7.0"
  }
}
